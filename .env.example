# Token do bot, obtido com o @BotFather no Telegram
TELEGRAM_TOKEN=coloque_seu_token_aqui

# Chave da API do Google Gemini (https://aistudio.google.com/api-keys), usada pelo Nanobot
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo do Gemini (opcional; default do docker-compose: gemini-3.6-flash)
# Lista oficial: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash

# String de conexão usada pelo servidor MCP (deve bater com o docker-compose)
DATABASE_URL=postgresql://orcamento:orcamento@localhost:5432/orcamento

# Senha do Postgres usada pelo docker-compose (opcional, tem default)
POSTGRES_PASSWORD=orcamento
