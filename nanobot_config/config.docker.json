{
  "providers": {
    "ollama": {
      "apiBase": "http://ollama:11434"
    }
  },
  "modelPresets": {
    "local": {
      "label": "Qwen 2.5 3B (local)",
      "provider": "ollama",
      "model": "qwen2.5:3b",
      "maxTokens": 2048,
      "contextWindowTokens": 32768,
      "temperature": 0.2
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "local"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_TOKEN}",
      "allowFrom": ["*"]
    }
  },
  "tools": {
    "mcpServers": {
      "orcamento": {
        "url": "http://mcp-orcamento:8100/mcp"
      }
    }
  }
}
