{
  "providers": {
    "gemini": {
      "apiKey": "${GEMINI_API_KEY}"
    }
  },
  "modelPresets": {
    "primary": {
      "label": "Gemini Flash",
      "provider": "gemini",
      "model": "${GEMINI_MODEL}",
      "maxTokens": 4096,
      "contextWindowTokens": 262144,
      "temperature": 0.2
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "primary",
      "maxToolIterations": 6
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_TOKEN}",
      "allowFrom": ["*"]
    }
  },
  "tools": {
    "mcpServers": {
      "orcamento": {
        "command": "/opt/mcpvenv/bin/python3",
        "args": ["/opt/mcp_server/expense_tools.py"],
        "env": {
          "DATABASE_URL": "${DATABASE_URL}",
          "TELEGRAM_TOKEN": "${TELEGRAM_TOKEN}"
        }
      }
    }
  }
}
